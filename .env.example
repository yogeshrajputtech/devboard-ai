# ─────────────────────────────────────────────────────────────────────────
# DevBoard AI environment variables — TEMPLATE
#
# Copy this file to `.env` (or run `make setup`) and adjust as needed:
#
#     cp .env.example .env
#
# Docker Compose loads `.env` automatically and substitutes the ${VAR}
# placeholders in docker-compose.yml.
#
# `.env` is gitignored (it can hold real secrets); this committed
# `.env.example` documents which variables exist. The values below are safe
# local demo defaults.
# ─────────────────────────────────────────────────────────────────────────

# --- Postgres ---
POSTGRES_USER=devboard
POSTGRES_PASSWORD=devboard
POSTGRES_DB=devboard

# --- Backend (Go API) ---
# Port the Go app listens on INSIDE its container.
# NOTE: if you change this, also update the proxy target in
# frontend/vite.config.js (it points at http://backend:8080).
BACKEND_PORT=8080

# --- AI (Anthropic) ---
# Required for the four AI features (task generation, smart assistant, auto
# priority/tagging, natural-language search). If unset, the backend still
# starts and all non-AI CRUD works normally — AI endpoints return a clear
# "unavailable" response instead of the app crashing (see backend/ai.go).
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5 if unset.
ANTHROPIC_MODEL=claude-opus-5
# Per-call timeout in seconds — keeps a slow/hung Claude call from blocking
# a Gin worker goroutine indefinitely.
ANTHROPIC_TIMEOUT_SECONDS=20

# --- Host port mappings (the host side of host:container) ---
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8081
FRONTEND_HOST_PORT=8080
